# Copy to .env and fill in real values. Never commit .env.

# NCBI E-utilities. An API key is optional but raises the rate limit from
# 3 to 10 requests per second. Tool name and contact email are requested by
# NCBI usage policy so they can contact you if your client misbehaves.
NCBI_API_KEY=
NCBI_TOOL_NAME=bio-research-copilot
NCBI_CONTACT_EMAIL=you@example.com

# Local SQLite store for ingested papers and retrieval provenance (git-ignored).
DATABASE_PATH=data/bio_copilot.sqlite

# Embedding model. Downloaded once and then run locally; no API key needed.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional. Where to cache the downloaded model; defaults to the library's own cache.
EMBEDDING_CACHE_DIR=

# LLM synthesis. Optional: leave blank and the CLI answers with the deterministic
# extractive provider instead, so no paid service is needed to run this project.
# Enable with: uv sync --extra llm, then: bio-copilot answer ... --synthesis llm
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048

# A question is not a PubMed query: "Tell me about MYBPC3" searched literally
# matches nothing, because PubMed requires every term. A small model rewrites the
# question into a real query and supplies the synonyms the literature uses.
PLANNER_MODEL=claude-haiku-4-5-20251001

# Used by 'judge-faithfulness' to score whether each claim follows from the
# passage it cites. Only needed when running that evaluation.
JUDGE_MODEL=claude-sonnet-5

# Hard ceiling on tokens the public demo may spend per day, across planning and
# synthesis together. Past it the demo answers extractively and says so.
# Zero disables the language model entirely.
DEMO_DAILY_TOKENS=200000
