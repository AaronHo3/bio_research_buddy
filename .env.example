# Copy to .env and fill in real values. Never commit .env.

# NCBI E-utilities. An API key is optional but raises the rate limit from
# 3 to 10 requests per second. Tool name and contact email are requested by
# NCBI usage policy so they can contact you if your client misbehaves.
NCBI_API_KEY=
NCBI_TOOL_NAME=bio-research-copilot
NCBI_CONTACT_EMAIL=you@example.com
